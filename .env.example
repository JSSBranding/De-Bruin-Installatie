# Omgeving: development | staging | production
# Alleen "production" laat zoekmachines indexeren en verbergt demo-inhoud.
PUBLIC_SITE_ENV=development

# Publieke URL van de website (voor canonical, sitemap en structured data)
PUBLIC_SITE_URL=https://www.debruininstallatie.nl

# Endpoint dat het contactformulier accepteert (bijv. Formspree: https://formspree.io/f/xxxxxxx).
# Leeg = formulier verstuurt niets en toont een duidelijke melding.
PUBLIC_FORM_ENDPOINT=

# Zet op "false" om demo-projecten ook in development te verbergen.
PUBLIC_SHOW_DEMO=true
