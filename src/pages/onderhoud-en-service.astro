---
/**
 * Canonieke pagina voor de dienst "Onderhoud en service".
 * Bereikbaar via het hoofdmenu en via het dienstenoverzicht;
 * /diensten/onderhoud-en-service/ verwijst hierheen.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { getEntry } from 'astro:content';

const service = await getEntry('diensten', 'onderhoud-en-service');
if (!service) throw new Error('Dienst onderhoud-en-service ontbreekt in src/content/diensten');
---

<BaseLayout title={service.data.metaTitle} description={service.data.metaDescription}>
  <ServiceDetail
    service={service}
    breadcrumbs={[{ label: 'Diensten', href: '/diensten/' }, { label: service.data.title }]}
  >
    <section class="section section--alt" slot="contact" aria-labelledby="service-aanvraag-title">
      <div class="container service-request">
        <div class="service-request__info">
          <h2 id="service-aanvraag-title">Onderhoud of reparatie aanvragen</h2>
          <p class="lead">Laat ons weten waar het om gaat. We nemen contact met je op om een afspraak te maken.</p>
          <h3>Handig om te vermelden</h3>
          <ul class="check-list" role="list">
            <li>Om welke installatie het gaat (bijvoorbeeld cv-ketel, warmtepomp of ventilatie-unit)</li>
            <li>Merk en type, als je dat weet</li>
            <li>Wat je opvalt, zoals een foutcode, geluid of lekkage</li>
            <li>Wanneer je bereikbaar bent</li>
          </ul>
          <ContactDetails />
        </div>
        <ContactForm preselect="onderhoud" id="contactformulier" title="Doe een serviceaanvraag" />
      </div>
    </section>
  </ServiceDetail>
</BaseLayout>

<style>
  .service-request {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .service-request__info > * + * {
    margin-top: var(--space-4);
  }
  .service-request__info h3 {
    margin-top: var(--space-6);
    font-size: var(--fs-h4);
  }
  @media (min-width: 64em) {
    .service-request {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
  }
</style>
