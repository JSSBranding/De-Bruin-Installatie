---
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import { images } from '../config/images';
import ServiceGrid from '../components/ServiceGrid.astro';
import WorkGallery from '../components/WorkGallery.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, primaryCta } from '../config/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const featured = (projects.filter((p) => p.data.featured).length ? projects.filter((p) => p.data.featured) : projects).slice(0, 3);

const steps = ['Neem contact op', 'Advies op maat', 'Vakkundig geïnstalleerd'] as const;

const strengths = [
  { title: 'Persoonlijk contact', text: 'met de vakman zelf' },
  { title: 'Eerlijk advies', text: 'wat past bij jouw woning' },
  { title: 'Nieuwbouw en renovatie', text: 'van leiding tot badkamer' },
  { title: 'Onderhoud en service', text: 'ook na de oplevering' },
] as const;

const scope = [
  'Badkamers en sanitair',
  'Cv-ketels en verwarming',
  'Warmtepompen',
  'Ventilatie en WTW',
  'Loodgieters- en leidingwerk',
  'Onderhoud en reparaties',
];
---

<BaseLayout
  title="Installatiebedrijf in Sint-Oedenrode | De Bruin Installatie"
  description="De Bruin Installatie uit Sint-Oedenrode: badkamers, cv-installaties, warmtepompen, ventilatie, loodgieterswerk en onderhoud. Vakmanschap en persoonlijk advies."
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 id="hero-title">Vertrouwd in installatie&shy;techniek.</h1>
        <p class="lead">
          Installatiebedrijf uit {company.city} voor badkamers, verwarming en duurzame oplossingen.
        </p>
        <div class="btn-row">
          <a href={primaryCta.href} class="btn btn--lg">{primaryCta.label}</a>
          <a href="/diensten/" class="btn btn--secondary btn--lg">Bekijk onze diensten</a>
        </div>
      </div>
      <div class="hero__media">
        <Media id="home.hero" ratio="3/2" eager sizes="(min-width: 60rem) 56vw, 100vw" class="hero__photo" />
      </div>
    </div>

    <div class="hero__base">
      <div class="container">
      <ol class="hero__steps" role="list" aria-label="Zo werkt het">
        {
          steps.map((title, i) => (
            <li class="hero-step">
              <span class="hero-step__num" aria-hidden="true">{i + 1}</span>
              <span class="hero-step__title">{title}</span>
            </li>
          ))
        }
      </ol>
      </div>
    </div>
  </section>

  <!-- Over ons -->
  <section class="about" aria-labelledby="about-title">
    <div class="container about__inner">
      <div class="about__media">
        <Media id="home.intro" sizes="(min-width: 60rem) 40vw, 100vw" class="about__photo" />
        {
          company.phone && (
            <a href={company.phone.href} class="about__call">
              <Icon name="phone" />
              <span>
                <span class="about__call-label">Bel direct</span>
                <strong>{company.phone.display}</strong>
              </span>
            </a>
          )
        }
      </div>
      <div class="about__text">
        <h2 id="about-title">Eén vakpartner voor installaties in en om je woning</h2>
        <p>
          Een nieuwe badkamer, een betrouwbare verwarming of je woning verduurzamen? <strong
            >De Bruin Installatie denkt met je mee</strong
          > en zorgt voor een oplossing die past bij jouw wensen en je woning.
        </p>
        <p>
          We werken bij <strong>nieuwbouw en renovatie</strong> en onderhouden bestaande installaties. Daarbij combineren
          we traditioneel vakmanschap met moderne installatietechniek.
        </p>
        <ul class="about__scope" role="list">
          {scope.map((item) => <li>{item}</li>)}
        </ul>
        <a href="/over-ons/" class="btn btn--secondary">Meer over ons</a>
      </div>
    </div>
  </section>

  <!-- Diensten -->
  <section class="section section--alt services" aria-labelledby="diensten-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 id="diensten-title">Waarmee we je helpen</h2>
        <p>Van een nieuwe badkamer tot een warmtepomp: kies een onderwerp en lees wat we voor je kunnen doen.</p>
      </div>
      <ServiceGrid variant="index" />
    </div>
  </section>

  <!-- Sterke punten: de blauwe band -->
  <section class="strengths on-dark" aria-labelledby="strengths-title">
    <div class="container strengths__inner">
      <h2 id="strengths-title">Vakwerk van een vast team uit {company.city}</h2>
      <ul class="strengths__list" role="list">
        {
          strengths.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </li>
          ))
        }
      </ul>
      {
        company.phone && (
          <a href={company.phone.href} class="strengths__call">
            <span class="strengths__number">{company.phone.display}</span>
            <span class="strengths__label">Bel ons gerust voor advies</span>
          </a>
        )
      }
    </div>
  </section>

  <!-- Uit de praktijk -->
  <section class="section work-section" aria-labelledby="werk-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 id="werk-title">Ons werk</h2>
        <p>Een greep uit installaties die we hebben aangelegd.</p>
      </div>
      <WorkGallery exclude={[images['home.intro'].file, images['home.hero'].file]} />
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section section--alt" aria-labelledby="projecten-title">
        <div class="container">
          <div class="section-head section-head--row">
            <h2 id="projecten-title">Uitgelicht werk</h2>
            <a href="/projecten/" class="link-arrow">
              Alle projecten
            </a>
          </div>
          <ul class="project-grid" role="list">
            {featured.map((p) => (
              <li>
                <ProjectCard project={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <PartnerLogos />

  <CtaBand />
</BaseLayout>

<style>
  /* ── Hero: tekst op vijf kolommen, de teamfoto op zes ── */
  .hero {
    background: var(--color-paper);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .hero h1 {
    font-size: clamp(2.75rem, 3.6vw + 1rem, 5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-inline-size: 11ch;
    hyphens: manual;
  }
  .hero .lead {
    margin-top: var(--space-lg);
    max-inline-size: 30ch;
  }
  .hero .btn-row {
    margin-top: var(--space-xl);
  }
  .hero__media :global(.hero__photo) {
    --media-radius: var(--radius-lg);
  }

  /* De drie stappen langs de onderkant van het eerste scherm */
  .hero__base {
    background: var(--color-paper-2);
    border-top: var(--rule);
  }
  .hero__steps {
    display: grid;
    counter-reset: none;
  }
  .hero-step {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    border-top: var(--rule);
  }
  .hero-step:first-child {
    border-top: 0;
  }
  .hero-step__num {
    flex: none;
    font-size: var(--text-title);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .hero-step__title {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.25;
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-2xl);
      padding-block: var(--space-2xl);
    }
    .hero__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gap-columns);
    }
    .hero-step {
      border-top: 0;
      padding-block: var(--space-xl);
    }
    .hero-step + .hero-step {
      border-left: var(--rule);
      padding-left: var(--gap-columns);
    }
  }

  /* ── Over ons: foto op vijf kolommen, tekst op zes ───── */
  .about {
    padding-block: var(--section-gap);
  }
  .about__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .about__media {
    position: relative;
  }
  .about__media :global(.about__photo) {
    --media-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
  }
  .about__call {
    position: absolute;
    left: var(--space-lg);
    bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    background: var(--color-field);
    color: var(--color-field-ink);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .about__call:hover {
    background: var(--color-accent);
    color: var(--color-field-ink);
  }
  .about__call:active {
    background: var(--color-accent-hover);
  }
  .about__call:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .about__call :global(.icon) {
    flex: none;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--color-signal);
  }
  .about__call-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-field-muted);
  }
  .about__call strong {
    font-size: var(--text-title);
    line-height: 1.2;
    white-space: nowrap;
  }
  .about__text > * + * {
    margin-top: var(--space-md);
  }
  .about__text h2 {
    max-inline-size: 16ch;
    margin-bottom: var(--space-lg);
  }
  .about__text p {
    color: var(--color-ink-2);
    max-inline-size: 52ch;
  }
  .about__text p strong {
    color: var(--color-ink);
  }
  .about__scope {
    display: grid;
    gap: 0 var(--gap-columns);
    padding-block: var(--space-md) var(--space-lg);
  }
  .about__scope li {
    position: relative;
    padding: var(--space-sm) 0 var(--space-sm) var(--space-lg);
    border-bottom: var(--rule);
    font-weight: var(--fw-medium);
  }
  .about__scope li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    inline-size: var(--space-sm);
    block-size: 2px;
    background: var(--color-signal);
  }
  @media (min-width: 40rem) {
    .about__scope {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .about__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap-columns);
    }
    .about__media {
      grid-column: 1 / span 5;
    }
    .about__text {
      grid-column: 7 / span 6;
    }
  }

  /* ── De blauwe band: het nummer van de bus ──────────── */
  .strengths {
    background: var(--color-band);
    color: var(--color-field-ink);
    padding-block: var(--section-gap-s);
  }
  .strengths__inner {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
  }
  .strengths h2 {
    color: var(--color-field-ink);
    max-inline-size: 14ch;
  }
  .strengths__list {
    display: grid;
    gap: 0 var(--gap-columns);
    align-content: start;
  }
  .strengths__list li {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-band-rule);
  }
  .strengths__list strong {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }
  .strengths__list span {
    color: var(--color-band-muted);
  }
  .strengths__call {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-band-rule);
    color: var(--color-field-ink);
    text-decoration: none;
  }
  .strengths__number {
    font-size: var(--text-figure);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.16em;
  }
  .strengths__label {
    font-size: var(--text-lead);
    color: var(--color-band-muted);
  }
  .strengths__call:hover {
    color: var(--color-field-ink);
  }
  .strengths__call:hover .strengths__label {
    color: var(--color-field-ink);
  }
  .strengths__call:active .strengths__number {
    text-decoration-color: var(--color-field-ink);
  }
  .strengths__call:focus-visible {
    outline: 2px solid var(--color-field-ink);
    outline-offset: 6px;
  }
  @media (min-width: 40rem) {
    .strengths__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .strengths__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .strengths h2 {
      grid-column: 1 / span 5;
    }
    .strengths__list {
      grid-column: 7 / span 6;
    }
    .strengths__call {
      grid-column: 1 / -1;
    }
  }

  /* ── Ons werk: met weinig foto's staat de kop naast het beeld ── */
  @media (min-width: 64rem) {
    .work-section .container:has(:global(.work--few)) {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap-columns);
      align-items: center;
    }
    .work-section .container:has(:global(.work--few)) > .section-head {
      grid-column: 1 / span 4;
      display: block;
      margin-bottom: 0;
    }
    .work-section .container:has(:global(.work--few)) > .section-head > p {
      margin-top: var(--space-lg);
    }
    .work-section .container:has(:global(.work--few)) > :global(.work) {
      grid-column: 6 / span 7;
    }
  }

  /* ── Projecten ────────────────────────── */
  .project-grid {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
  }
  .project-grid > li {
    display: flex;
  }
  .project-grid > li > :global(*) {
    flex: 1;
  }
  @media (min-width: 40rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
