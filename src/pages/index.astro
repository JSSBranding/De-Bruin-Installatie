---
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import ServiceList from '../components/ServiceList.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, primaryCta } from '../config/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const featured = (projects.filter((p) => p.data.featured).length ? projects.filter((p) => p.data.featured) : projects).slice(0, 3);

const steps = [
  {
    title: 'Je vertelt wat je wilt',
    text: 'Bel, mail of stuur een bericht. Je hebt direct contact met de mensen die het werk ook uitvoeren.',
  },
  {
    title: 'We kijken mee en adviseren',
    text: 'We bekijken je woning en je wensen, en vertellen eerlijk wat past. Ook als dat iets anders is dan je dacht.',
  },
  {
    title: 'We voeren het zorgvuldig uit',
    text: 'Vakwerk tot in de details. We werken netjes en houden je op de hoogte tot alles af is.',
  },
];
---

<BaseLayout
  title="Installatiebedrijf in Sint-Oedenrode | De Bruin Installatie"
  description="De Bruin Installatie uit Sint-Oedenrode: badkamers, cv-installaties, warmtepompen, ventilatie, loodgieterswerk en onderhoud. Vakmanschap en persoonlijk advies."
>
  <!-- Hero: de mensen en de bussen staan voorop -->
  <section class="hero">
    <div class="hero__grid">
      <div class="hero__text">
        <h1>De Bruin Installatie. Vertrouwd in installatietechniek.</h1>
        <p class="lead">
          Van complete badkamers tot verwarmingsinstallaties en duurzame oplossingen. Vakmanschap, persoonlijk advies en
          installatiewerk dat met zorg wordt uitgevoerd, vanuit {company.city}.
        </p>
        <div class="btn-row">
          <a href={primaryCta.href} class="btn">{primaryCta.label}</a>
          <a href="/diensten/" class="btn btn--secondary">Bekijk onze diensten</a>
        </div>
        {
          company.phone && (
            <p class="hero__call">
              Of bel direct: <a href={company.phone.href}>{company.phone.display}</a>
            </p>
          )
        }
      </div>
      <figure class="hero__photo">
        <Media id="home.hero" eager sizes="(min-width: 64em) 55vw, 100vw" />
        <figcaption class="caption">Het team van De Bruin Installatie</figcaption>
      </figure>
    </div>
  </section>

  <!-- Kennismaking in één alinea -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container intro__inner">
      <h2 id="intro-title">Eén vakpartner voor alles in en om je woning</h2>
      <div class="intro__text">
        <p class="intro__statement">
          Een nieuwe badkamer, een betrouwbare verwarming of je huis verduurzamen? We denken met je mee en zorgen voor een
          oplossing die past bij jouw wensen en je woning.
        </p>
        <p>
          We werken bij nieuwbouw en renovatie, en onderhouden bestaande installaties. Traditioneel vakmanschap en moderne
          installatietechniek gaan bij ons samen.
        </p>
        <a href="/over-ons/" class="link-arrow">Maak kennis met ons</a>
      </div>
    </div>
  </section>

  <!-- Diensten als lijst -->
  <section class="section section--tight-top" aria-labelledby="diensten-title">
    <div class="container">
      <div class="split-head">
        <h2 id="diensten-title">Waarmee we je helpen</h2>
        <a href="/diensten/" class="link-arrow">Alle diensten</a>
      </div>
      <ServiceList />
    </div>
  </section>

  <!-- Uit de praktijk -->
  <section class="section section--alt" aria-labelledby="praktijk-title">
    <div class="container">
      <div class="split-head">
        <h2 id="praktijk-title">Uit de praktijk</h2>
        <p class="muted measure">Een paar beelden van installaties die we hebben aangelegd.</p>
      </div>
      <PhotoStrip
        items={[
          { id: 'badkamers.hero', caption: 'Badkamer met halfvrijstaand bad en inloopdouche' },
          { id: 'warmtepompen.1', caption: 'Warmtepompen in een parkeergarage' },
          { id: 'verwarming.hero', caption: 'Cv-installatie met verdeler voor vloerverwarming' },
        ]}
      />
    </div>
  </section>

  <!-- Werkwijze: een echte volgorde -->
  <section class="section" aria-labelledby="werkwijze-title">
    <div class="container">
      <h2 id="werkwijze-title" class="steps-title">Zo werken we</h2>
      <ol class="steps" role="list">
        {
          steps.map((step, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section section--alt" aria-labelledby="projecten-title">
        <div class="container">
          <div class="split-head">
            <h2 id="projecten-title">Recente projecten</h2>
            <a href="/projecten/" class="link-arrow">
              Alle projecten
            </a>
          </div>
          <ul class="project-grid" role="list">
            {featured.map((p) => (
              <li>
                <ProjectCard project={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <PartnerLogos />

  <CtaBand />
</BaseLayout>

<style>
  /* Hero: tekst links in de container, foto loopt door tot de rechterrand */
  .hero {
    padding-top: clamp(2rem, 1rem + 3vw, 4rem);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-6);
  }
  .hero__text {
    padding-inline: var(--gutter);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-inline-size: 13ch;
  }
  .hero .lead {
    margin-top: var(--space-5);
    max-inline-size: 32rem;
  }
  .hero .btn-row {
    margin-top: var(--space-6);
  }
  .hero__call {
    margin-top: var(--space-5);
    color: var(--text-muted);
  }
  .hero__call a {
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    text-decoration-color: var(--color-green);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .hero__photo .caption {
    padding-inline: var(--gutter);
  }
  @media (min-width: 64em) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: var(--space-8);
      padding-left: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    }
    .hero__text {
      padding-inline: 0;
      padding-bottom: var(--space-8);
    }
    .hero__photo .caption {
      padding-inline: 0;
    }
  }

  /* Intro */
  .intro__inner {
    display: grid;
    gap: var(--space-5) var(--space-9);
  }
  .intro h2 {
    font-size: var(--fs-h3);
    max-inline-size: 18ch;
  }
  .intro__statement {
    font-size: clamp(1.375rem, 1.15rem + 1vw, 2rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .intro__text > * + * {
    margin-top: var(--space-5);
  }
  .intro__text p:not(.intro__statement) {
    color: var(--text-muted);
    max-inline-size: 36rem;
  }
  .intro__text .link-arrow {
    display: inline-block;
  }
  @media (min-width: 64em) {
    .intro__inner {
      grid-template-columns: 4fr 8fr;
    }
    .intro h2 {
      padding-top: 0.5rem;
    }
  }

  .split-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-6);
  }

  /* Werkwijze */
  .steps-title {
    margin-bottom: var(--space-7);
  }
  .steps {
    display: grid;
    gap: var(--space-7);
  }
  .step {
    position: relative;
  }
  .step__num {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    background: var(--color-blue);
    color: var(--color-white);
    font-weight: var(--fw-bold);
    font-size: 1.125rem;
  }
  .step h3 {
    font-size: var(--fs-h4);
    margin-bottom: var(--space-2);
  }
  .step p {
    color: var(--text-muted);
    max-inline-size: 22rem;
  }
  @media (min-width: 48em) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
    /* Doorlopende lijn tussen de stappen */
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.375rem;
      left: 3.5rem;
      right: calc(-1 * var(--space-6) + 0.75rem);
      block-size: 2px;
      background: var(--color-grey-light);
    }
  }

  .project-grid {
    display: grid;
    gap: var(--space-5);
  }
  .project-grid > li {
    display: flex;
  }
  .project-grid > li > :global(*) {
    flex: 1;
  }
  @media (min-width: 40em) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
