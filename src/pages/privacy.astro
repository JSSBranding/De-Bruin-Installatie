---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { company, formEndpoint } from '../config/site';

const todo = (text: string) => `[${text}: af te stemmen]`;
const a = company.address;
const address = company.showAddress ? `${a.street}, ${a.postalCode} ${a.city}` : todo('adres');
---

<BaseLayout
  title="Privacyverklaring"
  description="Lees hoe De Bruin Installatie omgaat met je persoonsgegevens, bijvoorbeeld als je het contactformulier gebruikt."
  index={company.privacyApproved}
>
  <PageHero title="Privacyverklaring" eyebrow="Privacy" breadcrumbs={[{ label: 'Privacyverklaring' }]} />

  <section class="section">
    <div class="container container--narrow">
      {
        !company.privacyApproved && (
          <div class="concept" role="note">
            <strong>Concepttekst.</strong> Deze privacyverklaring is een eerste opzet en nog niet definitief goedgekeurd.
            Onderdelen tussen [vierkante haken] moeten nog worden ingevuld en gecontroleerd.
          </div>
        )
      }

      <div class="prose">
        <p>
          {company.name} respecteert je privacy. In deze verklaring lees je welke persoonsgegevens we verwerken, waarom we
          dat doen en welke rechten je hebt.
        </p>

        <h2>Wie zijn wij?</h2>
        <p>
          {company.legalName ?? company.name}<br />
          {address}<br />
          KvK-nummer: {company.kvk ?? todo('KvK-nummer')}<br />
          {company.email && <>E-mail: <a href={`mailto:${company.email}`}>{company.email}</a></>}
        </p>

        <h2>Welke gegevens verwerken we?</h2>
        <p>Als je ons contactformulier invult, verwerken we:</p>
        <ul>
          <li>je naam;</li>
          <li>je e-mailadres;</li>
          <li>je telefoonnummer, als je dat invult;</li>
          <li>het type aanvraag en je bericht.</li>
        </ul>
        <p>
          Neem je telefonisch of per e-mail contact op, dan verwerken we de gegevens die je ons daarbij zelf geeft. Als je
          klant wordt, verwerken we daarnaast de gegevens die nodig zijn om de opdracht uit te voeren en te factureren,
          zoals je adres. {todo('Volledige lijst gegevens klanten')}
        </p>

        <h2>Waarom verwerken we deze gegevens?</h2>
        <ul>
          <li>om je vraag of aanvraag te beantwoorden;</li>
          <li>om een offerte op te stellen en afspraken te maken;</li>
          <li>om de opdracht uit te voeren en te factureren;</li>
          <li>om te voldoen aan wettelijke verplichtingen, zoals de fiscale bewaarplicht.</li>
        </ul>
        <p>
          We verwerken je gegevens omdat dit nodig is om je verzoek af te handelen of een overeenkomst met je uit te voeren,
          of omdat we daartoe wettelijk verplicht zijn. {todo('Grondslagen juridisch controleren')}
        </p>

        <h2>Hoe lang bewaren we je gegevens?</h2>
        <p>
          We bewaren je gegevens niet langer dan nodig. Berichten via het contactformulier die niet tot een opdracht leiden,
          bewaren we {todo('bewaartermijn')}. Gegevens die we voor de administratie nodig hebben, bewaren we zolang de wet
          dat verplicht.
        </p>

        <h2>Met wie delen we je gegevens?</h2>
        <p>
          We verkopen je gegevens nooit aan derden. We delen gegevens alleen met partijen die ons helpen onze diensten te
          leveren, zoals onze websitehosting {todo('naam hostingpartij')}
          {formEndpoint ? ' en de dienst die ons contactformulier verwerkt' : ''}
          {todo('naam formulierdienst')}. Met deze partijen maken we afspraken over de beveiliging van je gegevens.
        </p>

        <h2>Cookies en statistieken</h2>
        <p>
          Deze website gebruikt geen tracking- of advertentiecookies en geen bezoekersstatistieken. Wordt dat in de
          toekomst anders, dan passen we deze verklaring aan.
        </p>

        <h2>Je rechten</h2>
        <p>
          Je hebt het recht om je gegevens in te zien, te laten corrigeren of te laten verwijderen. Ook kun je bezwaar maken
          tegen de verwerking of vragen om je gegevens over te dragen. Stuur je verzoek naar
          {company.email ? <a href={`mailto:${company.email}`}> {company.email}</a> : ` ${todo('e-mailadres')}`}. Ben je
          het niet eens met hoe we met je gegevens omgaan? Dan kun je een klacht indienen bij de Autoriteit
          Persoonsgegevens.
        </p>

        <h2>Wijzigingen</h2>
        <p>We kunnen deze privacyverklaring aanpassen. De meest actuele versie vind je altijd op deze pagina.</p>
        <p class="muted">Laatst bijgewerkt: {todo('datum')}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .concept {
    margin-bottom: var(--space-7);
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-lime);
    background: var(--surface-alt);
    font-size: var(--fs-sm);
  }
</style>
