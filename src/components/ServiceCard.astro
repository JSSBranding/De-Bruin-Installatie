---
import Media from './Media.astro';
import type { Service } from '../lib/content';
import { serviceHref } from '../lib/content';
import type { ImageKey } from '../config/images';

interface Props {
  service: Service;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel: H = 'h3' } = Astro.props;
const d = service.data;
---

<article class="service-card">
  <Media
    id={d.heroImage as ImageKey}
    ratio="16/11"
    sizes="(min-width: 64em) 360px, (min-width: 40em) 50vw, 100vw"
    class="service-card__media"
  />
  <div class="service-card__body">
    <H class="service-card__title">
      <a href={serviceHref(service)} class="service-card__link">{d.title}</a>
    </H>
    <p class="service-card__text">{d.summary}</p>
    <span class="service-card__more" aria-hidden="true">Lees meer <span class="chev">»</span></span>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.875rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 0 rgb(12 42 71 / 0.04);
    transition:
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .service-card :global(.service-card__media) {
    --media-radius: var(--radius-md);
  }
  .service-card:hover,
  .service-card:focus-within {
    box-shadow: var(--shadow-card);
    transform: translateY(-3px);
  }
  .service-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5) var(--space-3) var(--space-3);
  }
  .service-card__title {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    margin-bottom: var(--space-3);
  }
  .service-card__link {
    color: var(--color-ink);
    text-decoration: none;
  }
  .service-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .service-card__link:focus-visible {
    outline: none;
  }
  .service-card:has(.service-card__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .service-card:hover .service-card__link {
    color: var(--color-blue);
  }
  .service-card__text {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
  .service-card__more {
    margin-top: auto;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }
  .chev {
    display: inline-block;
    margin-left: 0.25rem;
    color: var(--color-blue);
    transition: transform var(--dur) var(--ease);
  }
  .service-card:hover .chev {
    transform: translateX(3px);
  }
</style>
