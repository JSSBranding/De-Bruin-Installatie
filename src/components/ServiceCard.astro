---
import Media from './Media.astro';
import type { Service } from '../lib/content';
import { serviceHref } from '../lib/content';
import type { ImageKey } from '../config/images';

interface Props {
  service: Service;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel: H = 'h3' } = Astro.props;
const d = service.data;
---

<article class="service-card">
  <Media
    id={d.heroImage as ImageKey}
    ratio="16/11"
    sizes="(min-width: 64em) 360px, (min-width: 40em) 50vw, 100vw"
    class="service-card__media"
  />
  <div class="service-card__body">
    <H class="service-card__title">
      <a href={serviceHref(service)} class="service-card__link">{d.title}</a>
    </H>
    <p class="service-card__text">{d.summary}</p>
    <span class="service-card__more" aria-hidden="true">Lees meer</span>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .service-card :global(.service-card__media) {
    --media-radius: var(--radius-lg);
  }
  .service-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: var(--space-lg);
  }
  .service-card__title {
    font-size: var(--text-title);
    margin-bottom: var(--space-sm);
  }
  .service-card__link {
    color: var(--color-ink);
    text-decoration: none;
  }
  .service-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
  }
  .service-card__link:focus-visible {
    outline: none;
  }
  .service-card:has(.service-card__link:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 6px;
  }
  .service-card:hover .service-card__link {
    color: var(--color-accent);
  }
  .service-card:active .service-card__link {
    color: var(--color-accent-hover);
  }
  .service-card__text {
    color: var(--color-ink-2);
    margin-bottom: var(--space-lg);
    max-inline-size: 42ch;
  }
  .service-card__more {
    margin-top: auto;
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.3em;
  }
  .service-card:hover .service-card__more {
    text-decoration-color: currentColor;
  }
</style>
