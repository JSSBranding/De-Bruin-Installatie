---
import ServiceCard from './ServiceCard.astro';
import { getServices } from '../lib/content';

interface Props {
  headingLevel?: 'h2' | 'h3';
  exclude?: string;
}
const { headingLevel = 'h3', exclude } = Astro.props;
const services = (await getServices()).filter((s) => s.id !== exclude);
---

<ul class="service-grid" role="list">
  {
    services.map((service) => (
      <li>
        <ServiceCard service={service} index={service.data.order - 1} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>

<style>
  .service-grid {
    display: grid;
    gap: var(--space-5);
  }
  .service-grid > li {
    display: flex;
  }
  .service-grid > li > :global(*) {
    flex: 1;
  }
  @media (min-width: 40em) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .service-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
