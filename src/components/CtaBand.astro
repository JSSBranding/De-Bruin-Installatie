---
import Icon from './Icon.astro';
import { company, primaryCta } from '../config/site';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = 'Plannen voor je badkamer, verwarming of verduurzaming?',
  text = 'Vertel ons wat je in gedachten hebt. We denken met je mee en laten je weten wat er mogelijk is in jouw woning.',
  ctaLabel = primaryCta.label,
  ctaHref = primaryCta.href,
} = Astro.props;
---

<section class="cta-band on-dark" aria-labelledby="cta-title">
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href={ctaHref} class="btn btn--light btn--lg">{ctaLabel}</a>
      {
        company.phone && (
          <a href={company.phone.href} class="btn btn--ghost-light btn--lg">
            <Icon name="phone" />
            Bel {company.phone.display}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-field);
    color: var(--color-field-ink);
    padding-block: var(--section-gap-s);
  }
  .cta-band__inner {
    display: grid;
    gap: var(--space-xl) var(--gap-columns);
    align-items: end;
  }
  .cta-band h2 {
    color: var(--color-field-ink);
    max-inline-size: 20ch;
  }
  .cta-band__text p {
    margin-top: var(--space-lg);
    max-inline-size: 46ch;
    color: var(--color-field-muted);
    font-size: var(--text-lead);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .cta-band__actions :global(.icon) {
    color: var(--color-signal);
  }
  @media (min-width: 60rem) {
    .cta-band__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .cta-band__text {
      grid-column: 1 / span 8;
    }
    .cta-band__actions {
      grid-column: 9 / span 4;
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
