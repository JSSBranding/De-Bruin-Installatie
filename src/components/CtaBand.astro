---
/**
 * Afsluitend contactblok. Het telefoonnummer staat groot, zoals de belettering op de bus.
 */
import Icon from './Icon.astro';
import { company, primaryCta } from '../config/site';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = 'Plannen voor je badkamer, verwarming of verduurzaming?',
  text = 'Vertel ons wat je in gedachten hebt. We denken met je mee en laten je weten wat er in jouw woning mogelijk is.',
  ctaLabel = 'Stuur een bericht',
  ctaHref = primaryCta.href,
} = Astro.props;
---

<section class="contact-band on-dark" aria-labelledby="cta-title">
  <div class="container contact-band__inner">
    <div class="contact-band__text">
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
      <a href={ctaHref} class="btn btn--light">{ctaLabel}</a>
    </div>
    {
      company.phone && (
        <div class="contact-band__lettering">
          <p class="contact-band__call">Liever even bellen?</p>
          <a href={company.phone.href} class="contact-band__phone">
            <Icon name="phone" />
            <span>{company.phone.display}</span>
          </a>
          {company.email && (
            <a href={`mailto:${company.email}`} class="contact-band__mail">
              {company.email}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .contact-band {
    background: var(--color-blue);
    color: var(--color-white);
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .contact-band__inner {
    display: grid;
    gap: var(--space-7);
    align-items: end;
  }
  .contact-band h2 {
    color: var(--color-white);
    font-size: var(--fs-h2);
    max-inline-size: 20ch;
  }
  .contact-band__text p {
    margin-block: var(--space-4) var(--space-6);
    max-inline-size: 34rem;
    color: var(--color-blue-tint);
    font-size: var(--fs-lead);
  }
  .contact-band__call {
    font-style: italic;
    color: var(--color-blue-soft);
  }
  .contact-band__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: var(--space-2);
    font-size: clamp(1.9rem, 1.2rem + 3.2vw, 3.75rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .contact-band__phone :global(.icon) {
    inline-size: 0.8em;
    block-size: 0.8em;
    color: var(--color-green);
    stroke-width: 2.25;
  }
  .contact-band__phone:hover {
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: var(--color-green);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.15em;
  }
  .contact-band__mail {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: 1.125rem;
    font-weight: var(--fw-medium);
    color: var(--color-white);
    text-decoration-color: var(--color-green);
    text-underline-offset: 0.25em;
  }
  .contact-band__mail:hover {
    color: var(--color-white);
  }
  .contact-band__lettering {
    display: grid;
    justify-items: start;
  }
  @media (min-width: 64em) {
    .contact-band__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-9);
    }
  }
</style>
