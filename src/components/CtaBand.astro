---
import Icon from './Icon.astro';
import { company, primaryCta } from '../config/site';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = 'Plannen voor je badkamer, verwarming of verduurzaming?',
  text = 'Vertel ons wat je in gedachten hebt. We denken met je mee en laten je weten wat er mogelijk is in jouw woning.',
  ctaLabel = primaryCta.label,
  ctaHref = primaryCta.href,
} = Astro.props;
---

<section class="cta-band on-dark" aria-labelledby="cta-title">
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <p class="eyebrow eyebrow--light">Contact</p>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href={ctaHref} class="btn btn--light">
        {ctaLabel}
        <Icon name="arrow" class="icon--arrow" />
      </a>
      {
        company.phone && (
          <a href={company.phone.href} class="btn btn--ghost-light">
            <Icon name="phone" />
            Bel {company.phone.display}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    background: var(--color-blue);
    color: var(--color-white);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }
  /* Gekantelde tegels uit het beeldmerk, zeer subtiel */
  .cta-band::after {
    content: '';
    position: absolute;
    right: -6rem;
    bottom: -9rem;
    inline-size: 26rem;
    block-size: 26rem;
    background:
      linear-gradient(rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.07)) 0 0 / 55% 50% no-repeat,
      linear-gradient(rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.05)) 100% 100% / 48% 50% no-repeat;
    transform: rotate(-8deg);
    pointer-events: none;
  }
  .cta-band__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }
  .cta-band h2 {
    color: var(--color-white);
    max-inline-size: 22ch;
  }
  .cta-band__text p:not(.eyebrow) {
    margin-top: var(--space-4);
    max-inline-size: 38rem;
    color: var(--color-blue-tint);
    font-size: var(--fs-lead);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media (min-width: 64em) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }
    .cta-band__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
