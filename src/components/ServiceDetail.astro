---
/**
 * Template voor een dienstpagina. Wordt gebruikt door /diensten/[slug]/ en /onderhoud-en-service/.
 */
import PageHero from './PageHero.astro';
import Media from './Media.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import CtaBand from './CtaBand.astro';
import { render } from 'astro:content';
import { getServices, getProjects, serviceHref, type Service } from '../lib/content';
import type { ImageKey } from '../config/images';

interface Props {
  service: Service;
  breadcrumbs: { label: string; href?: string }[];
}
const { service, breadcrumbs } = Astro.props;
const { Content } = await render(service);
const d = service.data;
const contactHref = `/contact/?onderwerp=${d.requestType}#contactformulier`;

const projects = (await getProjects()).filter((p) => p.data.services.some((ref) => ref.id === service.id)).slice(0, 3);
const others = (await getServices()).filter((s) => s.id !== service.id);
---

<PageHero title={d.title} intro={d.intro} breadcrumbs={breadcrumbs}>
  <div class="btn-row" slot="actions">
    <a href={contactHref} class="btn">
      {d.ctaLabel}
    </a>
  </div>
  <Media slot="media" id={d.heroImage as ImageKey} eager sizes="(min-width: 64em) 580px, 100vw" />
</PageHero>

<section class="section" aria-labelledby="werk-title">
  <div class="container service-body">
    <div class="service-body__main">
      <h2 id="werk-title">{d.tasksTitle}</h2>
      <div class="prose service-body__prose">
        <Content />
      </div>
    </div>
    <div class="service-body__tasks">
      <ul class="task-list" role="list">
        {
          d.tasks.map((task) => (
            <li>
              <Icon name="check" />
              <span>{task}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="section section--alt" aria-labelledby="voordelen-title">
  <div class="container benefits-wrap">
    <div class="section-head">
      <h2 id="voordelen-title">Waarom kiezen voor De Bruin Installatie</h2>
    </div>
    <ul class="benefits" role="list">
      {
        d.benefits.map((b, i) => (
          <li class="benefit">
            <span class="benefit__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  (d.considerations || d.gallery.length > 0) && (
    <section class="section" aria-labelledby={d.considerations ? 'afwegingen-title' : undefined} aria-label={d.considerations ? undefined : `Foto's ${d.shortTitle.toLowerCase()}`}>
      <div class:list={['container', 'detail-split', { 'detail-split--single': !d.considerations || d.gallery.length === 0 }]}>
        {d.considerations && (
          <div class="considerations">
            <h2 id="afwegingen-title">{d.considerations.title}</h2>
            {d.considerations.intro && <p class="muted">{d.considerations.intro}</p>}
            <ul class="check-list" role="list">
              {d.considerations.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a href={contactHref} class="link-arrow">
              Bespreek het met ons
            </a>
          </div>
        )}
        {d.gallery.length > 0 && (
          <ul class:list={['gallery', `gallery--${Math.min(d.gallery.length, 3)}`]} role="list">
            {d.gallery.map((key) => (
              <li>
                <Media id={key as ImageKey} sizes="(min-width: 64em) 360px, (min-width: 40em) 50vw, 100vw" />
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

{
  projects.length > 0 && (
    <section class="section section--alt" aria-labelledby="projecten-title">
      <div class="container">
        <div class="section-head">
          <h2 id="projecten-title">Uitgevoerd werk</h2>
        </div>
        <ul class="card-grid" role="list">
          {projects.map((p) => (
            <li>
              <ProjectCard project={p} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<slot name="contact">
  <CtaBand
    title={`Vragen over ${d.shortTitle.toLowerCase()}?`}
    text="Vertel ons kort wat je in gedachten hebt. We nemen contact met je op om je situatie en de mogelijkheden te bespreken."
    ctaLabel={d.ctaLabel}
    ctaHref={contactHref}
  />
</slot>

<section class="section" aria-labelledby="andere-title">
  <div class="container">
    <div class="section-head section-head--row">
      <div>
        <h2 id="andere-title">Ook bij ons voor</h2>
      </div>
      <a href="/diensten/" class="link-arrow">Alle diensten</a>
    </div>
    <ul class="other-services" role="list">
      {
        others.map((s) => (
          <li>
            <a href={serviceHref(s)}>
              <span class="other-services__icon" aria-hidden="true">
                <Icon name={s.data.icon} />
              </span>
              {s.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .service-body {
    display: grid;
    gap: var(--space-6) var(--space-9);
  }
  .service-body__main h2 {
    max-inline-size: 18ch;
  }
  .service-body__prose {
    margin-top: var(--space-5);
    color: var(--text-muted);
  }
  .task-list {
    display: grid;
    border-top: var(--rule);
  }
  .task-list li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding-block: var(--space-4);
    border-bottom: var(--rule);
    font-weight: var(--fw-medium);
  }
  .task-list :global(.icon) {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    color: var(--color-green-ink);
    stroke-width: 2.5;
    margin-top: 0.2rem;
  }
  @media (min-width: 64em) {
    .service-body {
      grid-template-columns: 5fr 6fr;
    }
  }

  .benefits-wrap {
    display: grid;
    gap: 0 var(--space-9);
  }
  .benefits {
    display: grid;
    border-top: 2px solid var(--color-blue);
  }
  .benefit {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: var(--rule);
  }
  .benefit > :not(.benefit__num) {
    grid-column: 2;
  }
  .benefit__num {
    grid-row: span 2;
  }
  .benefit__num {
    display: block;
    padding-top: 0.2rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    color: var(--color-green-ink);
  }
  .benefit h3 {
    margin-bottom: var(--space-2);
  }
  .benefit p {
    color: var(--text-muted);
  }
  .benefit h3 {
    font-size: var(--fs-h4);
  }
  @media (min-width: 64em) {
    .benefits-wrap {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }

  .other-services {
    display: grid;
    gap: 0 var(--space-6);
    border-top: var(--rule);
  }
  .other-services a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-block-size: 3.75rem;
    border-bottom: var(--rule);
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    text-decoration: none;
  }
  .other-services a:hover {
    color: var(--color-blue);
  }
  .other-services__icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    background: var(--color-blue-tint);
    color: var(--color-blue);
  }
  .other-services__icon :global(.icon) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }
  @media (min-width: 40em) {
    .other-services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .other-services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .detail-split {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .considerations > * + * {
    margin-top: var(--space-4);
  }
  .considerations .check-list {
    margin-top: var(--space-5);
  }
  .considerations .link-arrow {
    margin-top: var(--space-6);
  }
  .gallery {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gallery > li:first-child {
    grid-column: 1 / -1;
  }
  .gallery--1 {
    grid-template-columns: 1fr;
  }
  .gallery--2 > li:first-child {
    grid-column: auto;
  }
  @media (min-width: 64em) {
    .detail-split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-9);
    }
    .detail-split--single {
      grid-template-columns: minmax(0, 46rem);
    }
    .detail-split--single:has(.gallery) {
      grid-template-columns: 1fr;
    }
    .detail-split--single .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .detail-split--single .gallery > li:first-child {
      grid-column: auto;
    }
  }

  .card-grid {
    display: grid;
    gap: var(--space-5);
  }
  .card-grid > li {
    display: flex;
  }
  .card-grid > li > :global(*) {
    flex: 1;
  }
  @media (min-width: 40em) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
