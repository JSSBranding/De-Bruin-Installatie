---
/**
 * Template voor een dienstpagina. Gebruikt door /diensten/[slug]/ en /onderhoud-en-service/.
 * Opbouw: kop met foto → lopende tekst met contactkolom → aandachtspunten → foto's → overige diensten.
 */
import { render } from 'astro:content';
import PageHero from './PageHero.astro';
import Media from './Media.astro';
import ProjectCard from './ProjectCard.astro';
import CtaBand from './CtaBand.astro';
import { getServices, getProjects, serviceHref, type Service } from '../lib/content';
import { company } from '../config/site';
import { images, type ImageKey } from '../config/images';

interface Props {
  service: Service;
  breadcrumbs: { label: string; href?: string }[];
}
const { service, breadcrumbs } = Astro.props;
const { Content } = await render(service);
const d = service.data;
const contactHref = `/contact/?onderwerp=${d.requestType}#contactformulier`;
const hero = d.heroImage as ImageKey;

const projects = (await getProjects()).filter((p) => p.data.services.some((ref) => ref.id === service.id)).slice(0, 3);
const others = (await getServices()).filter((s) => s.id !== service.id);
---

<PageHero title={d.title} intro={d.intro} breadcrumbs={breadcrumbs} caption={images[hero].alt}>
  <div class="btn-row" slot="actions">
    <a href={contactHref} class="btn">{d.ctaLabel}</a>
  </div>
  <Media slot="media" id={hero} eager sizes="(min-width: 64em) 620px, 100vw" />
</PageHero>

<section class="section service-main">
  <div class="container service-main__inner">
    <article class="service-main__body">
      <div class="prose service-main__lead">
        <Content />
      </div>

      <h2>{d.tasksTitle}</h2>
      <ul class="check-list" role="list">
        {d.tasks.map((task) => <li>{task}</li>)}
      </ul>

      <h2>Wat je eraan hebt</h2>
      <dl class="benefits">
        {
          d.benefits.map((b) => (
            <div>
              <dt>{b.title}</dt>
              <dd>{b.text}</dd>
            </div>
          ))
        }
      </dl>
    </article>

    <aside class="service-main__aside" aria-label="Contact over deze dienst">
      <div class="contact-note">
        <p class="contact-note__title">Vragen over {d.shortTitle.toLowerCase()}?</p>
        <p>Vertel kort wat je wilt. We nemen contact met je op om de mogelijkheden te bespreken.</p>
        <a href={contactHref} class="btn">{d.ctaLabel}</a>
        {
          company.phone && (
            <p class="contact-note__phone">
              Of bel <a href={company.phone.href}>{company.phone.display}</a>
            </p>
          )
        }
      </div>
    </aside>
  </div>
</section>

{
  d.considerations && (
    <section class="section section--alt" aria-labelledby="afwegingen-title">
      <div class="container considerations">
        <h2 id="afwegingen-title">{d.considerations.title}</h2>
        <div>
          {d.considerations.intro && <p class="lead">{d.considerations.intro}</p>}
          <ul class="check-list" role="list">
            {d.considerations.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

{
  d.gallery.length > 0 && (
    <section class="section" aria-labelledby="fotos-title">
      <div class="container">
        <h2 id="fotos-title" class="gallery-title">
          Foto's
        </h2>
        <ul class:list={['gallery', `gallery--${Math.min(d.gallery.length, 3)}`]} role="list">
          {d.gallery.map((key) => (
            <li>
              <figure>
                <Media id={key as ImageKey} sizes="(min-width: 64em) 400px, (min-width: 40em) 50vw, 100vw" />
                <figcaption class="caption">{images[key as ImageKey].alt}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  projects.length > 0 && (
    <section class="section section--alt" aria-labelledby="projecten-title">
      <div class="container">
        <h2 id="projecten-title" class="gallery-title">
          Projecten
        </h2>
        <ul class="card-grid" role="list">
          {projects.map((p) => (
            <li>
              <ProjectCard project={p} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<slot name="contact">
  <CtaBand
    title={`Plannen voor ${d.shortTitle.toLowerCase()}?`}
    text="Vertel ons kort wat je in gedachten hebt. We nemen contact met je op om je situatie en de mogelijkheden te bespreken."
    ctaHref={contactHref}
  />
</slot>

<nav class="section others" aria-labelledby="andere-title">
  <div class="container others__inner">
    <h2 id="andere-title">Ook bij ons voor</h2>
    <ul role="list">
      {
        others.map((s) => (
          <li>
            <a href={serviceHref(s)}>{s.data.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .service-main__inner {
    display: grid;
    gap: var(--space-8);
  }
  .service-main__body {
    max-inline-size: 42rem;
  }
  .service-main__lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
  }
  .service-main__body h2 {
    font-size: var(--fs-h3);
    margin-block: var(--space-8) var(--space-5);
  }
  .benefits {
    display: grid;
    gap: var(--space-5);
  }
  .benefits dt {
    font-weight: var(--fw-bold);
  }
  .benefits dd {
    margin-top: var(--space-1);
    color: var(--text-muted);
  }
  .contact-note {
    padding: var(--space-6);
    background: var(--surface-alt);
    border-top: 4px solid var(--color-green);
  }
  .contact-note__title {
    font-size: var(--fs-h4);
    font-weight: var(--fw-bold);
  }
  .contact-note p:not(.contact-note__title) {
    margin-block: var(--space-3) var(--space-5);
    color: var(--text-muted);
  }
  .contact-note .contact-note__phone {
    margin-bottom: 0;
    margin-top: var(--space-4);
  }
  .contact-note__phone a {
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    white-space: nowrap;
  }
  @media (min-width: 64em) {
    .service-main__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-9);
    }
    .service-main__aside {
      position: relative;
    }
    .contact-note {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }

  .considerations {
    display: grid;
    gap: var(--space-5) var(--space-9);
  }
  .considerations h2 {
    font-size: var(--fs-h3);
    max-inline-size: 18ch;
  }
  .considerations .lead {
    margin-bottom: var(--space-5);
  }
  @media (min-width: 64em) {
    .considerations {
      grid-template-columns: 4fr 7fr;
    }
  }

  .gallery-title {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-5);
  }
  .gallery {
    display: grid;
    gap: var(--space-5) var(--space-4);
  }
  @media (min-width: 40em) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gallery--1 {
      grid-template-columns: minmax(0, 40rem);
    }
  }
  @media (min-width: 64em) {
    .gallery--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card-grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 40em) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .others__inner {
    display: grid;
    gap: var(--space-4) var(--space-9);
  }
  .others h2 {
    font-size: var(--fs-h4);
  }
  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .others a {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
    font-weight: var(--fw-medium);
    font-size: 1.125rem;
    color: var(--color-ink);
    text-decoration-color: var(--color-green);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .others a:hover {
    color: var(--color-blue);
  }
  @media (min-width: 64em) {
    .others__inner {
      grid-template-columns: 4fr 7fr;
      align-items: baseline;
    }
  }
</style>
