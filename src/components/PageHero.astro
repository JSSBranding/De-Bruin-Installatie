---
/**
 * Kop voor binnenpagina's: kruimelpad, H1, intro en optioneel een foto met bijschrift.
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  intro?: string;
  breadcrumbs: { label: string; href?: string }[];
  caption?: string;
}
const { title, intro, breadcrumbs, caption } = Astro.props;
const withMedia = Astro.slots.has('media');
---

<section class:list={['page-hero', { 'page-hero--media': withMedia }]}>
  <div class="container page-hero__inner">
    <div class="page-hero__text">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      <slot name="actions" />
    </div>
    {
      withMedia && (
        <figure class="page-hero__media">
          <slot name="media" />
          {caption && <figcaption class="caption">{caption}</figcaption>}
        </figure>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-6) var(--space-8);
    border-bottom: var(--rule);
  }
  .page-hero--media {
    border-bottom: 0;
    padding-bottom: var(--space-6);
  }
  .page-hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: end;
  }
  .page-hero__text :global(.breadcrumbs) {
    margin-bottom: var(--space-7);
  }
  .page-hero h1 {
    max-inline-size: 16ch;
    font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .page-hero .lead {
    margin-top: var(--space-5);
    max-inline-size: 36rem;
  }
  .page-hero__text :global(.btn-row) {
    margin-top: var(--space-6);
  }
  @media (min-width: 64em) {
    .page-hero--media .page-hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
    }
    .page-hero--media .page-hero__text {
      padding-bottom: var(--space-6);
    }
  }
</style>
