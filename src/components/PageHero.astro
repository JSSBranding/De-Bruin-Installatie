---
/**
 * Kop voor binnenpagina's: kruimelpad, H1, intro en optioneel beeld + acties.
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  intro?: string;
  breadcrumbs: { label: string; href?: string }[];
  /** true als er een media-slot is (beeld rechts) */
  withMedia?: boolean;
}
const { title, intro, breadcrumbs, withMedia = Astro.slots.has('media') } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--media': withMedia }]}>
  <div class="container page-hero__inner">
    <div class="page-hero__text">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      <slot name="actions" />
    </div>
    {
      withMedia && (
        <div class="page-hero__media">
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-xl) var(--space-3xl);
    background: var(--color-paper);
    border-bottom: var(--rule);
  }
  .page-hero__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .page-hero__text :global(.breadcrumbs) {
    margin-bottom: var(--space-2xl);
  }
  .page-hero h1 {
    max-inline-size: 16ch;
  }
  .page-hero .lead {
    margin-top: var(--space-lg);
  }
  .page-hero__text :global(.btn-row) {
    margin-top: var(--space-xl);
  }
  .page-hero__media :global(.media) {
    --media-radius: var(--radius-lg);
  }
  @media (min-width: 60rem) {
    .page-hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap-columns);
    }
    .page-hero__text {
      grid-column: 1 / span 6;
    }
    .page-hero:not(.page-hero--media) .page-hero__text {
      grid-column: 1 / span 9;
    }
    .page-hero__media {
      grid-column: 7 / span 6;
    }
  }
</style>
