---
/**
 * Foto's van uitgevoerd werk, filterbaar per soort. Zonder JavaScript is alles zichtbaar.
 * Alleen foto's die echt aanwezig zijn worden getoond, elk bestand één keer; lege
 * plekken staan in docs/ASSETS.md. Zijn er minder dan zes, dan vervallen de filterknoppen.
 */
import Media from './Media.astro';
import { images, type ImageKey } from '../config/images';
import { findImage } from '../lib/images';

interface Props {
  /** Bestanden die elders op de pagina al staan */
  exclude?: string[];
}
const { exclude = [] } = Astro.props;

const filters = [
  { value: 'alles', label: 'Alles' },
  { value: 'badkamer', label: 'Badkamers' },
  { value: 'verwarming', label: 'Verwarming' },
  { value: 'warmtepomp', label: 'Warmtepompen' },
  { value: 'zonnepanelen', label: 'Zonnepanelen' },
] as const;

const all: { id: ImageKey; cat: (typeof filters)[number]['value'] }[] = [
  { id: 'badkamers.hero', cat: 'badkamer' },
  { id: 'warmtepompen.1', cat: 'warmtepomp' },
  { id: 'verwarming.hero', cat: 'verwarming' },
  { id: 'badkamers.1', cat: 'badkamer' },
  { id: 'warmtepompen.hero', cat: 'warmtepomp' },
  { id: 'badkamers.2', cat: 'badkamer' },
  { id: 'warmtepompen.2', cat: 'warmtepomp' },
  { id: 'badkamers.3', cat: 'badkamer' },
  { id: 'warmtepompen.3', cat: 'warmtepomp' },
  { id: 'werk.zonnepanelen', cat: 'zonnepanelen' },
];

const seen = new Set(exclude);
const items = all.filter(({ id }) => {
  const file = images[id].file;
  if (seen.has(file) || !findImage(file)) return false;
  seen.add(file);
  return true;
});
const usedFilters = filters.filter((f) => f.value === 'alles' || items.some((i) => i.cat === f.value));
const showFilters = items.length >= 6 && usedFilters.length > 2;
const few = items.length < 3;
---

<div class:list={['work', { 'work--few': few }]} data-work>
  <div class="work__filters" role="group" aria-label="Filter op soort werk" data-work-filters hidden>
    {
      showFilters && usedFilters.map((f, i) => (
        <button type="button" class="work__filter" data-filter={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
        </button>
      ))
    }
  </div>
  <ul class="work__grid" role="list" aria-live="polite">
    {
      items.map((item) => (
        <li data-cat={item.cat}>
          <figure>
            <Media id={item.id} ratio="4/3" sizes={few ? '(min-width: 60rem) 50vw, 100vw' : '(min-width: 64em) 420px, (min-width: 40em) 50vw, 100vw'} class="work__media" />
            <figcaption>{images[item.id].alt}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-work]').forEach((root) => {
    const bar = root.querySelector<HTMLElement>('[data-work-filters]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-cat]')];
    if (!bar || buttons.length === 0) return;
    bar.hidden = false;
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((li) => (li.hidden = f !== 'alles' && li.dataset.cat !== f));
      }),
    );
  });
</script>

<style>
  .work__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }
  .work__filters[hidden] {
    display: none;
  }
  .work__filter {
    min-block-size: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    transition:
      background-color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }
  .work__filter:hover {
    border-color: var(--color-ink);
  }
  .work__filter:active {
    background: var(--color-paper-2);
  }
  .work__filter:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .work__filter[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .work__grid {
    display: grid;
    gap: var(--space-xl) var(--gap-columns);
  }
  .work__grid li[hidden] {
    display: none;
  }
  .work__grid :global(.work__media) {
    --media-radius: var(--radius-lg);
  }
  .work__grid figcaption {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  @media (min-width: 40rem) {
    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .work__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Weinig foto's: groot, één of twee naast elkaar */
    .work--few .work__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .work--few .work__grid > li {
      grid-column: span 6;
    }
    .work--few .work__grid > li:only-child {
      grid-column: 1 / -1;
    }
  }
</style>
