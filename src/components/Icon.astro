---
/**
 * Eenvoudige lijn-iconen (24×24, stroke). Decoratief: aria-hidden.
 */
interface Props {
  name:
    | 'arrow'
    | 'phone'
    | 'mail'
    | 'pin'
    | 'menu'
    | 'close'
    | 'bath'
    | 'flame'
    | 'heatpump'
    | 'fan'
    | 'pipe'
    | 'wrench'
    | 'chat'
    | 'clipboard'
    | 'check';
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  phone:
    '<path d="M5 4h4l1.5 4.5-2.25 1.5a11 11 0 0 0 5.75 5.75L15.5 13.5 20 15v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
