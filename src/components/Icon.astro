  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M5 5l14 14M19 5 5 19"/>',
  bath: '<path d="M3 12h18v2a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-2Z"/><path d="M6 12V5.5A2.5 2.5 0 0 1 8.5 3 2.5 2.5 0 0 1 11 5.5"/><path d="M7 19l-1 2M17 19l1 2"/>',
  flame:
    '<path d="M12 21a6 6 0 0 0 6-6c0-4-3-6-4-10-2.5 2-3 4-3 6-1-.5-2-1.6-2-3-1.6 1.6-3 4-3 7a6 6 0 0 0 6 6Z"/><path d="M12 21a2.5 2.5 0 0 1-2.5-2.5c0-1.5 1.5-2.5 2.5-4 1 1.5 2.5 2.5 2.5 4A2.5 2.5 0 0 1 12 21Z"/>',
  heatpump:
    '<rect x="2.5" y="5" width="19" height="14" rx="1"/><circle cx="9" cy="12" r="4"/><path d="M9 8v8M5 12h8"/><path d="M16 9h3M16 12h3M16 15h3"/>',
  fan: '<circle cx="12" cy="12" r="1.8"/><path d="M12 10.2C11 6 12.5 3 15 3.5c2.4.5 1.8 4.5-1.4 7.4"/><path d="M13.6 12.9c3.6 2.4 4.9 5.5 3 7.1-1.9 1.6-4.6-1.4-5-5.6"/><path d="M10.4 12.8C6.4 14.3 3.2 13.6 3 11.2c-.2-2.5 3.8-3 7.4-.9"/>',
  pipe: '<path d="M3 7h7a4 4 0 0 1 4 4v10"/><path d="M3 11h7"/><path d="M10 21h8"/><path d="M14 3h4v4h-4z"/><path d="M16 7v4"/>',
  wrench:
    '<path d="M14.5 6.5a4 4 0 0 0 5.2 5.2l-8.9 8.9a2.1 2.1 0 0 1-3-3l8.9-8.9a4 4 0 0 1-2.2-2.2Z" transform="translate(-1 -1)"/><path d="M15 3.5a4 4 0 0 1 5.5 5.5l-3-.5-1-1-.5-3Z" transform="translate(-1 -1)"/>',
  chat: '<path d="M4 5h16v11H9l-4 3.5V16H4z"/><path d="M8 9.5h8M8 12.5h5"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="1"/><path d="M9 4V3h6v1"/><path d="M8.5 10h7M8.5 13.5h7M8.5 17h4"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
};
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
