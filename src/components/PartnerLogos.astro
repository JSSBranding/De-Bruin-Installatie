---
/**
 * Merk- en partnerlogo's. Standaard verborgen (zie showPartners in src/config/images.ts).
 * Toont alleen logo's die bestaan én expliciet zijn goedgekeurd. Logo's worden niet herkleurd.
 */
import { Image } from 'astro:assets';
import { partners, showPartners } from '../config/images';
import { findImage } from '../lib/images';

const visible = showPartners
  ? partners
      .filter((p) => p.approved)
      .map((p) => ({ ...p, src: findImage(p.file) }))
      .filter((p) => p.src !== null)
  : [];
---

{
  visible.length > 0 && (
    <section class="section partners" aria-labelledby="partners-title">
      <div class="container">
        <h2 id="partners-title" class="partners__title">
          Merken waarmee we werken
        </h2>
        <ul class="partners__list" role="list">
          {visible.map((p) => (
            <li>
              <Image src={p.src!} alt={p.name} height={56} densities={[1, 2]} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .partners {
    padding-block: var(--space-7);
  }
  .partners__title {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: var(--space-5);
  }
  .partners__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-6) var(--space-8);
  }
  .partners__list :global(img) {
    block-size: 3.5rem;
    inline-size: auto;
    object-fit: contain;
  }
</style>
