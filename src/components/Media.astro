---
/**
 * Toont een foto uit de centrale beeldconfiguratie (src/config/images.ts)
 * of een losse foto (file + alt). Ontbreekt het bestand, dan verschijnt een
 * placeholder met exact dezelfde verhouding: geen kapotte afbeeldingen en
 * geen verspringende layout.
 */
import { Picture } from 'astro:assets';
import { images, type ImageKey } from '../config/images';
import { findImage } from '../lib/images';
import { isProduction } from '../config/site';

interface Props {
  id?: ImageKey;
  file?: string;
  alt?: string;
  ratio?: string;
  focus?: string;
  label?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const props = Astro.props;
const slot = props.id ? images[props.id] : undefined;
const file = props.file ?? slot?.file ?? '';
const alt = props.alt ?? slot?.alt ?? '';
const ratio = props.ratio ?? slot?.ratio ?? '4/3';
const focus = props.focus ?? (slot && 'focus' in slot ? slot.focus : undefined) ?? '50% 50%';
const label = props.label ?? slot?.label ?? alt;
const sizes = props.sizes ?? '(min-width: 76rem) 600px, (min-width: 48rem) 50vw, 100vw';

const src = file ? findImage(file) : null;
const widths = src ? [480, 800, 1200, 1600, 2000].filter((w) => w <= src.width) : [];
if (src && widths.length === 0) widths.push(src.width);
---

<div class:list={['media', props.class]} style={`--ratio:${ratio};--focus:${focus}`}>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={props.eager ? 'eager' : 'lazy'}
        fetchpriority={props.eager ? 'high' : 'auto'}
        decoding="async"
      />
    ) : isProduction ? (
      <div class="media__placeholder" aria-hidden="true" />
    ) : (
      <div class="media__placeholder" role="img" aria-label={`Plaats voor foto: ${label}`}>
        <span class="media__label">
          <span class="media__tag">Foto volgt</span>
          {label}
          <code>{file}</code>
        </span>
      </div>
    )
  }
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--media-radius, 0);
    background: var(--color-paper-3);
  }
  .media :global(picture),
  .media :global(img) {
    inline-size: 100%;
    block-size: 100%;
  }
  .media :global(img) {
    object-fit: cover;
    object-position: var(--focus);
  }
  .media__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    background-color: var(--color-paper-3);
  }
  .media__label {
    display: grid;
    gap: 0.15rem;
    max-inline-size: 100%;
    padding: 0.5rem 0.7rem;
    background: var(--color-paper);
    font-size: var(--fs-xs);
    line-height: 1.35;
    color: var(--color-grey-ink);
  }
  .media__tag {
    font-weight: var(--fw-medium);
    color: var(--color-accent);
  }
  .media__label code {
    font-family: inherit;
    font-size: 0.75rem;
    overflow-wrap: anywhere;
    opacity: 0.8;
  }
</style>
